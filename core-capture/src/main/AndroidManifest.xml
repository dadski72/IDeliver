<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared here too so module-level lint sees it for the odometer prompt. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!--
          Primary capture path. The system binds this via the signature
          permission below (only the framework holds it), driven by the
          "Notification access" toggle in system settings. No foreground-service
          type applies — NotificationListenerService is a system-bound service.
        -->
        <service
            android:name=".NotificationCaptureService"
            android:label="IDeliver capture"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Secondary/enrichment path. Read-only offer-screen reader; the system
          binds it via the signature BIND_ACCESSIBILITY_SERVICE permission when
          the user turns it on in Accessibility settings.
        -->
        <service
            android:name=".OfferAccessibilityService"
            android:label="IDeliver offer reader"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/offer_accessibility_service" />
        </service>
    </application>

</manifest>
